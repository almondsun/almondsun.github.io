---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/social-card.png",
  canonical: includeCanonical = true,
  noindex = false,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const pageTitle =
  title === "Home" ? "Martín Ramírez Espinosa" : `${title} · Martín Ramírez Espinosa`;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Martín Ramírez Espinosa",
  alternateName: "almondsun",
  url: "https://almondsun.github.io",
  email: "mailto:maramirezes@unal.edu.co",
  affiliation: { "@type": "CollegeOrUniversity", name: "Universidad Nacional de Colombia" },
  memberOf: {
    "@type": "Organization",
    name: "Grupo de Control y Procesamiento Digital de Señales (GCPDS)",
    url: "https://scienti.minciencias.gov.co/gruplac/jsp/visualiza/visualizagr.jsp?nro=00000000001375",
    parentOrganization: {
      "@type": "CollegeOrUniversity",
      name: "Universidad Nacional de Colombia",
    },
  },
  knowsLanguage: ["Spanish", "English"],
  sameAs: ["https://github.com/almondsun", "https://www.linkedin.com/in/martin-ramirez-espinosa/"],
  knowsAbout: [
    "Machine learning systems",
    "Research engineering",
    "Signal processing",
    "Embedded systems",
    "Local-first software",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3efe5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101820" media="(prefers-color-scheme: dark)" />
    {includeCanonical && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {includeCanonical && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Martín Ramírez Espinosa — research-oriented engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const preferred = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.dataset.theme =
            stored === "light" || stored === "dark" ? stored : preferred;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
