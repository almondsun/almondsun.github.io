---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Not found"
  description="The requested portfolio page could not be found."
  canonical={false}
  noindex
>
  <section class="not-found shell section">
    <p class="eyebrow">404 · Outside the evidence boundary</p>
    <h1>This page does not exist.</h1>
    <p>The route may have changed, but the selected work is still available from the homepage.</p>
    <a class="button button-primary" href="/">Return home</a>
  </section>
</BaseLayout>
