---
import { Picture } from "astro:assets";
import portrait from "../assets/images/martin-ramirez-espinosa.webp";
---

<figure class="portrait">
  <Picture
    src={portrait}
    alt="Portrait of Martín Ramírez Espinosa"
    decoding="sync"
    fetchpriority="high"
    layout="constrained"
    widths={[320, 480, 720, 1086]}
    sizes="(max-width: 56rem) min(100vw - 1.25rem, 400px), min(26vw, 340px)"
    formats={["avif"]}
    fallbackFormat="webp"
  />
</figure>
