---
import type { Note } from "../data/notes";

interface Props {
  note: Note;
}

const { note } = Astro.props;
---

<article class="note-card">
  <p class="eyebrow">{note.project} · {note.kind}</p>
  <h3>{note.title}</h3>
  <p>{note.summary}</p>
  <ul class="tag-list" aria-label={`${note.title} topics`}>
    {note.topics.map((topic) => <li>{topic}</li>)}
  </ul>
  <a class="text-link" href={note.href}>Read the artifact <span aria-hidden="true">↗</span></a>
</article>
